                          isChildActive(child)
                            ? 'bg-zinc-200/90 text-zinc-900 dark:bg-zinc-800 dark:text-zinc-100 font-semibold'
                            : 'text-zinc-500 hover:bg-zinc-100 hover:text-zinc-900 dark:text-zinc-400 dark:hover:bg-zinc-800/60 dark:hover:text-zinc-100 font-medium'
                        ]">
                        {{ child.name }}
                      </Link>
                    </div>
                  </template>

                  <SidebarMenuButton v-else :is-active="isItemActive(item)"

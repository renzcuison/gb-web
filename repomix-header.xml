<script setup>
import { ref, computed } from 'vue'
import { Link, usePage } from '@inertiajs/vue3'
import Logo from '@/Components/Logo.vue'
import RecentActivities from '@/Components/RecentActivities.vue'
import GlobalSearch from '@/Components/GlobalSearch.vue'
import NotificationDropdown from '@/Components/NotificationDropdown.vue'
import UserMenu from '@/Components/UserMenu.vue'
import {
  ImsDashboardIcon,
  ImsInventoryIcon,
  ImsAlertsIcon,
  ImsInquiriesIcon,
  ImsAnnouncementsIcon,
  ImsUsersIcon,
  ImsChevronDownIcon,
} from '@/Components/Icons/ImsIcons.vue'
import {
  SidebarProvider,
  Sidebar,
  SidebarContent,
  SidebarGroup,
  SidebarGroupContent,
  SidebarGroupLabel,
  SidebarMenu,
  SidebarMenuButton,
  SidebarMenuItem,
  SidebarTrigger,
  SidebarInset
} from '@/Components/ui/sidebar'

const page = usePage()
const openMenus = ref({
  Inventory: true,
})

const toggleMenu = (name) => {
  openMenus.value[name] = !openMenus.value[name]
}

const adminBadges = computed(() => page.props.admin_badges || { unresolved_alerts: 0, new_inquiries: 0 })

const navGroups = [
  {
    label: 'Management',
    items: [
      { name: 'Dashboard', href: '/dashboard', icon: ImsDashboardIcon },
      {
        name: 'Inventory',
        href: '/inventory',
        icon: ImsInventoryIcon,
        children: [
          { name: 'Stock Inventory', href: '/inventory' },
          { name: 'Movement Logs', href: '/inventory/movements' },
          { name: 'Categories', href: '/categories' },
          { name: 'Brands', href: '/brands' },
          { name: 'Tags', href: '/tags' },
        ],
      },
      { name: 'Alerts', href: '/inventory/alerts', icon: ImsAlertsIcon, badgeKey: 'unresolved_alerts' },
      { name: 'Inquiries', href: '/inquiries', icon: ImsInquiriesIcon, badgeKey: 'new_inquiries' },
      { name: 'Announcements', href: '/announcements', icon: ImsAnnouncementsIcon },
      { name: 'Users', href: '/users', icon: ImsUsersIcon },
    ]
  }
]

const getCurrentPath = () => page.url.split('?')[0]

const isChildActive = (child) => {
  const currentPath = getCurrentPath()

  if (child.href === '/inventory') {
    return currentPath === '/inventory' || currentPath.startsWith('/products')
  }

  return currentPath === child.href || currentPath.startsWith(`${child.href}/`)
}

const isItemActive = (item) => {
  const currentPath = getCurrentPath()

  if (item.children) {
    return item.children.some((child) => isChildActive(child))
  }

  return currentPath === item.href || currentPath.startsWith(`${item.href}/`)
}
</script>


                                ? 'text-slate-900 dark:text-zinc-100'
                                : 'text-slate-400 dark:text-zinc-500'
                            ]" />
                          <span class="truncate">{{ item.name }}</span>
                        </Link>

                        <button
                          type="button"
                          @click.stop="toggleMenu(item.name)"

      <div class="flex flex-wrap items-center gap-3">
        <div class="flex items-center gap-3 text-xs font-mono">
          <span class="text-emerald-600 dark:text-emerald-400">
            +{{ stats.units_in.toLocaleString() }} units in
          </span>
          <span class="text-slate-300 dark:text-zinc-700">|</span>
          <span class="text-rose-600 dark:text-rose-400">
            -{{ stats.units_out.toLocaleString() }} units out
          </span>
        </div>

        <DropdownMenu>
          <DropdownMenuTrigger as-child>
            <Button
              size="sm"
              variant="outline"
              class="h-8 text-xs font-medium gap-1.5 border-slate-200 dark:border-zinc-800 bg-white hover:bg-slate-50 dark:bg-zinc-900 dark:hover:bg-zinc-800/80 text-slate-700 dark:text-zinc-300 px-3 shadow-none">
              <Download class="h-3.5 w-3.5" />
              <span>Export</span>
              <ChevronDown class="h-3 w-3 opacity-60" />
            </Button>
          </DropdownMenuTrigger>
          <DropdownMenuContent align="end" class="w-44 dark:bg-zinc-900 dark:border-zinc-800 shadow-none">
            <DropdownMenuItem as-child class="text-xs cursor-pointer">
              <a :href="buildExportUrl('xlsx')">Export Excel (.xlsx)</a>
            </DropdownMenuItem>
            <DropdownMenuItem as-child class="text-xs cursor-pointer">
              <a :href="buildExportUrl('csv')">Export CSV (.csv)</a>
            </DropdownMenuItem>
          </DropdownMenuContent>
        </DropdownMenu>
      </div>
    </div>

    <div class="space-y-3">
      <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-2">
        <div class="relative flex-1 max-w-xs">
          <Search class="h-3.5 w-3.5 text-slate-400 dark:text-zinc-500 absolute left-2.5 top-1/2 -translate-y-1/2 pointer-events-none" />
          <Input
            v-model="search"
            type="text"
            placeholder="Search item, SKU, or reason..."
            class="h-8 pl-8 pr-7 text-xs bg-white dark:bg-zinc-900 border-slate-200/80 dark:border-zinc-800 text-slate-900 dark:text-zinc-100 placeholder:text-slate-400 dark:placeholder:text-zinc-500 focus-visible:ring-1 shadow-none"
          />
          <button
            v-if="search"
            type="button"
            @click="search = ''"
            class="absolute right-2 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-600 dark:hover:text-zinc-300">
            <X class="h-3.5 w-3.5" />
          </button>
        </div>

        <div class="flex flex-wrap items-center gap-2">
          <DropdownMenu>
            <DropdownMenuTrigger as-child>
              <Button
                variant="outline"
                size="sm"
                :class="[
                  'h-8 text-xs font-medium gap-1.5 px-2.5 shadow-none border-slate-200/80 dark:border-zinc-800',
                  user
                    ? 'bg-slate-900 text-white dark:bg-zinc-100 dark:text-zinc-900'
                    : 'bg-white dark:bg-zinc-900 text-slate-600 dark:text-zinc-300',
                ]">
                <span>{{ selectedActorName }}</span>
                <ChevronDown class="h-3 w-3 opacity-60" />
              </Button>
            </DropdownMenuTrigger>
            <DropdownMenuContent align="end" class="w-48 dark:bg-zinc-900 dark:border-zinc-800 shadow-none">
              <template v-if="actors.length > 0">
                <DropdownMenuItem
                  v-for="actor in actors"
                  :key="actor.id"
                  @click="toggleUser(actor.id)"
                  class="text-xs flex items-center justify-between cursor-pointer">
                  <span>{{ actor.name }}</span>
                  <Check v-if="user === actor.id" class="h-3.5 w-3.5" />
                </DropdownMenuItem>
              </template>
              <div v-else class="px-2.5 py-2 text-xs text-slate-400 dark:text-zinc-500">
                No recorded users
              </div>
            </DropdownMenuContent>
          </DropdownMenu>

          <div class="flex items-center gap-1.5">
            <input
              v-model="from"
              type="date"
              aria-label="From date"
              @change="applyFilters"
              class="h-8 rounded-md border border-slate-200/80 dark:border-zinc-800 bg-white dark:bg-zinc-900 px-2.5 text-xs text-slate-600 dark:text-zinc-300 focus:outline-none focus:ring-1 focus:ring-slate-400 dark:focus:ring-zinc-600"
            />
            <span class="text-xs text-slate-400 dark:text-zinc-500">to</span>
            <input
              v-model="to"
              type="date"
              aria-label="To date"
              @change="applyFilters"
              class="h-8 rounded-md border border-slate-200/80 dark:border-zinc-800 bg-white dark:bg-zinc-900 px-2.5 text-xs text-slate-600 dark:text-zinc-300 focus:outline-none focus:ring-1 focus:ring-slate-400 dark:focus:ring-zinc-600"
            />
          </div>

          <button
            v-if="hasActiveFilters"
            type="button"
            @click="resetAll"
            class="text-xs text-slate-500 hover:text-slate-900 dark:text-zinc-400 dark:hover:text-zinc-100 px-1.5 transition-colors">
            Reset
          </button>
        </div>
      </div>

      <div class="flex items-center gap-5 border-b border-slate-200/80 dark:border-zinc-800 text-xs">
        <button
          v-for="tab in typeTabs"
          :key="tab.key"
          type="button"
          @click="setType(tab.key)"
          :class="[
            '-mb-px pb-2 border-b-2 transition-colors flex items-center gap-1.5',

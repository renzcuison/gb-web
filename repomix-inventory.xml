<script setup>
import { ref, computed, watch } from 'vue'
import { Head, Link, router } from '@inertiajs/vue3'
import AdminLayout from '@/Layouts/AdminLayout.vue'
import InventoryNavTabs from '@/Components/InventoryNavTabs.vue'
import { Button } from '@/Components/ui/button'
import { Input } from '@/Components/ui/input'
import { Search, X, ChevronDown, Check, Download } from 'lucide-vue-next'
import {
  Table,
  TableBody,
  TableCell,
  TableHead,
  TableHeader,
  TableRow,
} from '@/Components/ui/table'
import {
  DropdownMenu,
  DropdownMenuContent,
  DropdownMenuItem,
  DropdownMenuTrigger,
} from '@/Components/ui/dropdown-menu'

defineOptions({ layout: AdminLayout })

const props = defineProps({
  movements: Object,
  stats: {
    type: Object,
    default: () => ({ total: 0, in_count: 0, out_count: 0, units_in: 0, units_out: 0 }),
  },
  actors: { type: Array, default: () => [] },
  filters: {
    type: Object,
    default: () => ({ search: '', type: 'all', user: null, from: '', to: '' }),
  },
})

const search = ref(props.filters.search || '')
const type = ref(props.filters.type || 'all')
const user = ref(props.filters.user || null)
const from = ref(props.filters.from || '')
const to = ref(props.filters.to || '')

const typeTabs = computed(() => [
  { key: 'all', label: 'All Movements', count: props.stats.total },
  { key: 'in', label: 'Stock In', count: props.stats.in_count },
  { key: 'out', label: 'Stock Out', count: props.stats.out_count },
])

const selectedActorName = computed(
  () => props.actors.find((a) => a.id === user.value)?.name || 'Recorded By'
)

const hasActiveFilters = computed(
  () =>
    Boolean(search.value) ||
    type.value !== 'all' ||
    user.value !== null ||
    Boolean(from.value) ||
    Boolean(to.value)
)

const buildExportUrl = (format) => {
  const params = new URLSearchParams()
  params.set('format', format)
  if (search.value) params.set('search', search.value)
  if (type.value && type.value !== 'all') params.set('type', type.value)
  if (user.value) params.set('user', String(user.value))
  if (from.value) params.set('from', from.value)
  if (to.value) params.set('to', to.value)
  return `${route('inventory.movements.export')}?${params.toString()}`
}

const applyFilters = () => {
  router.get(
    route('inventory.movements.index'),
    {
      search: search.value || undefined,
      type: type.value !== 'all' ? type.value : undefined,
      user: user.value || undefined,
      from: from.value || undefined,
      to: to.value || undefined,
    },
    { preserveState: true, preserveScroll: true, replace: true }
  )
}

let timer = null
watch(search, () => {
  clearTimeout(timer)
  timer = setTimeout(applyFilters, 300)
})

const setType = (val) => {
  type.value = val
  applyFilters()
}

const toggleUser = (id) => {
  user.value = user.value === id ? null : id
  applyFilters()
}

const resetAll = () => {
  search.value = ''
  type.value = 'all'
  user.value = null
  from.value = ''
  to.value = ''
  applyFilters()
}

const formatTimestamp = (dateStr) => {
  if (!dateStr) return '—'
  return new Date(dateStr).toLocaleString('en-US', {
    month: 'short',
    day: 'numeric',
    year: 'numeric',
    hour: '2-digit',
    minute: '2-digit',
  })
}
</script>

<template>
  <div class="w-full h-[calc(100vh-4rem)] overflow-y-auto pb-8 pr-1 space-y-4">
    <Head title="Movement Audit Logs" />

    <div class="sticky top-0 z-20 bg-slate-50 dark:bg-zinc-950 -mt-2 pt-2 pb-1">
      <InventoryNavTabs />
    </div>

    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 pt-1">
      <h1 class="text-xl font-semibold tracking-tight text-slate-900 dark:text-zinc-100">

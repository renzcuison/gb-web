        'is_resolved',
    ];

    protected function casts(): array
    {
        return [
            'threshold_reached' => 'integer',
            'is_resolved' => 'boolean',
        ];
    }

    public function variant(): BelongsTo
    {
        return $this->belongsTo(ProductVariant::class, 'variant_id');
    }

    public function productVariant(): BelongsTo
    {
        return $this->belongsTo(ProductVariant::class, 'variant_id');
    }
}

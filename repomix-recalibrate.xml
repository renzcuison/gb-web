<script setup>
import { ref, computed } from 'vue'
import { Head, Link } from '@inertiajs/vue3'
import AdminLayout from '@/Layouts/AdminLayout.vue'
import InventoryNavTabs from '@/Components/InventoryNavTabs.vue'
import ImportModal from '@/Components/ImportModal.vue'
import InventoryToolbar from './Components/InventoryToolbar.vue'
import InventoryTable from './Components/InventoryTable.vue'
import InventoryDetailSheet from './Components/InventoryDetailSheet.vue'
import StockAdjustmentModal from './Components/StockAdjustmentModal.vue'
import { Button } from '@/Components/ui/button'

defineOptions({ layout: AdminLayout })

const props = defineProps({
  inventory: Object,
  stats: {
    type: Object,
    default: () => ({ total: 0, in_stock: 0, low_stock: 0, out_of_stock: 0 }),
  },
  categories: { type: Array, default: () => [] },
  brands: { type: Array, default: () => [] },
  filters: {
    type: Object,
    default: () => ({ search: '', status: 'all', category: null, brand: null, sort: 'stock_asc' }),
  },
})

const isImportModalOpen = ref(false)
const isAdjustModalOpen = ref(false)
const isDetailSheetOpen = ref(false)
const adjustingVariant = ref(null)
const inspectedVariantId = ref(null)
const inspectedVariantFallback = ref(null)

const inspectedVariant = computed(() => {
  if (!inspectedVariantId.value) return null
  return (
    props.inventory?.data?.find((v) => v.id === inspectedVariantId.value) ||
    inspectedVariantFallback.value
  )
})

const openDetailSheet = (variant) => {
  inspectedVariantId.value = variant.id
  inspectedVariantFallback.value = variant
  isDetailSheetOpen.value = true
}

const openAdjustModal = (variant) => {
  adjustingVariant.value = variant
  isAdjustModalOpen.value = true
}
</script>

<template>
  <div class="w-full h-[calc(100vh-4rem)] overflow-y-auto pb-8 pr-1 space-y-4">
    <Head title="Inventory Management" />

    <div class="sticky top-0 z-20 bg-slate-50 dark:bg-zinc-950 -mt-2 pt-2 pb-1">
      <InventoryNavTabs />
    </div>

    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 pt-1">
      <h1 class="text-xl font-semibold tracking-tight text-slate-900 dark:text-zinc-100">
        Inventory Stock
      </h1>

      <div class="flex items-center gap-2">
        <Button
          size="sm"
          variant="outline"
          @click="isImportModalOpen = true"
          class="h-8 text-xs font-medium border-slate-200 dark:border-zinc-800 bg-white hover:bg-slate-50 dark:bg-zinc-900 dark:hover:bg-zinc-800/80 text-slate-700 dark:text-zinc-300 px-3 shadow-none">
          Import Excel
        </Button>

        <Button
          size="sm"
          as-child
          class="h-8 text-xs font-medium bg-slate-900 hover:bg-slate-800 text-white dark:bg-zinc-100 dark:text-zinc-900 dark:hover:bg-zinc-200 px-3 shadow-none">
          <Link :href="route('products.create')">
            Add Item Group
          </Link>
        </Button>
      </div>
    </div>

    <InventoryToolbar
      :stats="stats"
      :categories="categories"
      :brands="brands"
      :filters="filters"
    />

    <InventoryTable
      :inventory="inventory"
      :has-active-filters="Boolean(filters.search || filters.status !== 'all' || filters.category || filters.brand)"
      @select="openDetailSheet"
      @adjust="openAdjustModal"
    />

    <InventoryDetailSheet
      v-model:open="isDetailSheetOpen"
      :variant="inspectedVariant"
      @adjust="openAdjustModal"
    />


    <StockAdjustmentModal
      v-model:open="isAdjustModalOpen"
      :variant="adjustingVariant"
    />

    <ImportModal v-model:open="isImportModalOpen" />
  </div>
</template>
</file>

<file path="routes/web.php">
<?php

use App\Http\Controllers\ProfileController;
use Illuminate\Foundation\Application;
use App\Http\Controllers\ProductController;
use App\Http\Controllers\InventoryController;
use App\Http\Controllers\Auth\SocialAuthController;
use App\Http\Controllers\CategoryController;
use App\Http\Controllers\BrandController;
use App\Http\Controllers\SearchController;
use App\Http\Controllers\NotificationController;
use App\Http\Controllers\AnnouncementController;
use App\Http\Controllers\InventoryAlertController;
use App\Http\Controllers\TagController;
use Illuminate\Support\Facades\Route;
use Illuminate\Http\Request;
use Illuminate\Support\Facades\DB;
use App\Models\ProductVariant;
use App\Models\InventoryAlert;
use App\Models\InventoryMovement;
use App\Models\Announcement;
use Inertia\Inertia;

Route::get('/', [ProductController::class, 'index'])->name('storefront.index');

Route::get('auth/{provider}/redirect', [SocialAuthController::class, 'redirect'])
    ->name('social.redirect');
Route::get('auth/{provider}/callback', [SocialAuthController::class, 'callback'])
    ->name('social.callback');

Route::get('/dashboard', function (Request $request) {
    if ($request->user()->role === 'admin') {
        $stats = [
            'totalItems' => ProductVariant::count(),
            'outOfStockCount' => ProductVariant::where('stock_qty', '<=', 0)->count(),
            'lowStockCount' => ProductVariant::where('stock_qty', '>', 0)
                ->whereColumn('stock_qty', '<=', 'low_stock_threshold')
                ->count(),
            'activeAnnouncements' => Announcement::where('is_active', true)->count(),
            'totalValue' => ProductVariant::join('products', 'product_variants.product_id', '=', 'products.id')
                ->sum(DB::raw('stock_qty * COALESCE(product_variants.price_override, products.price, 0)')),
        ];

        $recentAlerts = InventoryAlert::with('productVariant.product')
            ->where('is_resolved', false)
            ->latest()
            ->take(6)
            ->get();

        $recentMovements = InventoryMovement::with(['variant.product', 'user'])
            ->latest()
            ->take(6)
            ->get();

        $topStockedItems = ProductVariant::with('product')
            ->orderByDesc('stock_qty')
            ->take(5)
            ->get();

        $activeAnnouncementsList = Announcement::where('is_active', true)
            ->orderByDesc('priority')
            ->latest()
            ->take(5)
            ->get();

        return Inertia::render('Admin/Dashboard', [
            'stats' => $stats,
            'recentAlerts' => $recentAlerts,
            'recentMovements' => $recentMovements,
            'topStockedItems' => $topStockedItems,
            'activeAnnouncementsList' => $activeAnnouncementsList,
        ]);
    }

    return Inertia::render('Dashboard');
})->middleware(['auth', 'verified'])->name('dashboard');
Route::middleware('auth')->group(function () {
    Route::get('/profile', [ProfileController::class, 'edit'])->name('profile.edit');
    Route::patch('/profile', [ProfileController::class, 'update'])->name('profile.update');
    Route::delete('/profile', [ProfileController::class, 'destroy'])->name('profile.destroy');

    Route::post('/notifications/{id}/read', [NotificationController::class, 'markAsRead'])->name('notifications.read');
    Route::post('/notifications/read-all', [NotificationController::class, 'markAllAsRead'])->name('notifications.read-all');
});

Route::middleware(['auth', 'admin'])->group(function () {
    Route::get('/inventory', [InventoryController::class, 'index'])->name('inventory.index');
    Route::post('/inventory/adjust', [InventoryController::class, 'adjust'])->name('inventory.adjust');

    // Product Management
    Route::get('/products/create', [ProductController::class, 'create'])->name('products.create');
    Route::post('/products', [ProductController::class, 'store'])->name('products.store');
    Route::get('/products/{product}/edit', [ProductController::class, 'edit'])->name('products.edit');
    Route::put('/products/{product}', [ProductController::class, 'update'])->name('products.update');
    Route::delete('/products/{product}', [ProductController::class, 'destroy'])->name('products.destroy');
    Route::post('/products/{id}/restore', [ProductController::class, 'restore'])->name('products.restore');
    Route::post('/products/import', [ProductController::class, 'import'])->name('products.import');

    // Catalog
    Route::resource('categories', CategoryController::class)->except(['create', 'show', 'edit']);
    Route::resource('brands', BrandController::class)->except(['create', 'show', 'edit']);
    Route::resource('tags', TagController::class)->except(['create', 'show', 'edit']);

    // Search
    Route::get('/api/search', SearchController::class)->name('api.search');

    // Inventory Alerts
    Route::get('/inventory/alerts', [InventoryAlertController::class, 'index'])->name('inventory.alerts.index');
    Route::patch('/inventory/alerts/{alert}/resolve', [InventoryAlertController::class, 'resolve'])->name('inventory.alerts.resolve');
    Route::post('/inventory/alerts/resolve-all', [InventoryAlertController::class, 'resolveAll'])->name('inventory.alerts.resolve-all');

    // Announcements
    Route::resource('announcements', AnnouncementController::class)->only(['index', 'store', 'update', 'destroy']);
    Route::patch('/announcements/{announcement}/toggle', [AnnouncementController::class, 'toggle'])->name('announcements.toggle');
});

Route::get('/products/{slug}', [ProductController::class, 'show'])->name('products.show');

require __DIR__ . '/auth.php';

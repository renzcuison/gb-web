<script setup>
import { ref, watch } from 'vue'
import { Head, Link, router, useForm } from '@inertiajs/vue3'
import AdminLayout from '@/Layouts/AdminLayout.vue'
import {
  Plus,
  Search,
  Megaphone,
  Pencil,
  Trash2,
  X,
} from 'lucide-vue-next'

const props = defineProps({
  announcements: { type: Object, required: true },
  stats: {
    type: Object,
    default: () => ({
      total: 0,
      active: 0,
      inactive: 0,
      high_priority: 0,
    }),
  },
  activePreview: { type: Array, default: () => [] },
  filters: {
    type: Object,
    default: () => ({
      search: '',
      status: 'all',
    }),
  },
})

const search = ref(props.filters.search ?? '')
const status = ref(props.filters.status ?? 'all')

const isModalOpen = ref(false)
const editingAnnouncement = ref(null)

const form = useForm({
  content: '',
  priority: 0,
  is_active: true,
})

let searchTimeout = null
const applyFilters = () => {
  router.get(
    route('announcements.index'),
    {
      search: search.value || undefined,
      status: status.value !== 'all' ? status.value : undefined,
    },
    {
      preserveState: true,
      preserveScroll: true,
      replace: true,
    }
  )
}

watch(search, () => {
  clearTimeout(searchTimeout)
  searchTimeout = setTimeout(applyFilters, 300)
})

const setStatus = (val) => {
  status.value = val
  applyFilters()
}

const openCreateModal = () => {
  editingAnnouncement.value = null
  form.reset()
  form.clearErrors()
  form.priority = 0
  form.is_active = true
  isModalOpen.value = true
}

const openEditModal = (item) => {
  editingAnnouncement.value = item
  form.clearErrors()
  form.content = item.content
  form.priority = item.priority
  form.is_active = Boolean(item.is_active)
  isModalOpen.value = true
}

const closeModal = () => {
  isModalOpen.value = false
  editingAnnouncement.value = null
}

const submitForm = () => {
  if (editingAnnouncement.value) {
    form.patch(route('announcements.update', editingAnnouncement.value.id), {
      preserveScroll: true,
      onSuccess: () => closeModal(),
    })
  } else {
    form.post(route('announcements.store'), {
      preserveScroll: true,
      onSuccess: () => closeModal(),
    })
  }
}

const toggleStatus = (item) => {
  router.patch(route('announcements.toggle', item.id), {}, { preserveScroll: true })
}

const deleteAnnouncement = (item) => {
  if (!confirm('Delete this announcement?')) return
  router.delete(route('announcements.destroy', item.id), { preserveScroll: true })
}

const formatDate = (iso) => {
  if (!iso) return '—'
  return new Intl.DateTimeFormat('en-PH', {
    month: 'short',
    day: 'numeric',
    year: 'numeric',
  }).format(new Date(iso))
}
</script>


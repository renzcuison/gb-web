<script setup>
import { ref, watch } from 'vue'
import { Head, Link, router, useForm } from '@inertiajs/vue3'
import AdminLayout from '@/Layouts/AdminLayout.vue'
import InventoryNavTabs from '@/Components/InventoryNavTabs.vue'
import { Button } from '@/Components/ui/button'
import { Input } from '@/Components/ui/input'
import { Plus, Pencil, Trash2, Award, Search, X } from 'lucide-vue-next'
import {
    Table,
    TableBody,
    TableCell,
    TableHead,
    TableHeader,
    TableRow,
} from '@/Components/ui/table'
import {
    Dialog,
    DialogContent,
    DialogHeader,
    DialogTitle,
    DialogFooter,
} from '@/Components/ui/dialog'

defineOptions({ layout: AdminLayout })

const props = defineProps({
    brands: {
        type: Object,
        default: () => ({ data: [], total: 0 }),
    },
    filters: {
        type: Object,
        default: () => ({ search: '' }),
    },
})

const search = ref(props.filters?.search || '')
const isModalOpen = ref(false)
const editingBrand = ref(null)

let timer = null
watch(search, (val) => {
    clearTimeout(timer)
    timer = setTimeout(() => {
        router.get(
            route('brands.index'),
            { search: val || undefined },
            { preserveState: true, preserveScroll: true, replace: true }
        )
    }, 300)
})

const form = useForm({
    name: '',
    description: '',
})

const openModal = (brand = null) => {
    form.clearErrors()
    editingBrand.value = brand
    if (brand) {
        form.name = brand.name
        form.description = brand.description || ''
    } else {
        form.reset()
    }
    isModalOpen.value = true
}

const closeModal = () => {
    isModalOpen.value = false
    editingBrand.value = null
    form.reset()
    form.clearErrors()
}

const handleSubmit = () => {
    if (editingBrand.value) {
        form.put(route('brands.update', editingBrand.value.id), {
            preserveScroll: true,
            onSuccess: () => closeModal(),
        })
    } else {
        form.post(route('brands.store'), {
            preserveScroll: true,
            onSuccess: () => closeModal(),
        })
    }
}

const deleteBrand = (brand) => {
    if (brand.products_count > 0) {
        alert(`Cannot delete ${brand.name} because it is associated with ${brand.products_count} product(s).`)
        return
    }

    if (confirm(`Are you sure you want to delete the brand "${brand.name}"?`)) {
        router.delete(route('brands.destroy', brand.id), {
            preserveScroll: true,
        })
    }
}
</script>

<template>
    <div class="w-full h-[calc(100vh-4rem)] overflow-y-auto pb-8 pr-1 space-y-4">
        <Head title="Brand Management" />

        <div class="sticky top-0 z-20 bg-slate-50 dark:bg-zinc-950 -mt-2 pt-2 pb-1">
            <InventoryNavTabs />
        </div>

        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 pt-1 pb-1">
            <h1 class="text-xl font-semibold tracking-tight text-slate-900 dark:text-zinc-100">

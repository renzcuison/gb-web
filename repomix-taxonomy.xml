<script setup>
import { ref } from 'vue'
import { Head, useForm } from '@inertiajs/vue3'
import AdminLayout from '@/Layouts/AdminLayout.vue'
import InventoryNavTabs from '@/Components/InventoryNavTabs.vue'
import { Button } from '@/Components/ui/button'
import { Input } from '@/Components/ui/input'
import { Plus, Pencil, Trash2, Tag } from 'lucide-vue-next'
import {
    Table,
    TableBody,
    TableCell,
    TableHead,
    TableHeader,
    TableRow,
} from '@/Components/ui/table'
import {
    Dialog,
    DialogContent,
    DialogHeader,
    DialogTitle,
    DialogFooter,
} from '@/Components/ui/dialog'

defineOptions({ layout: AdminLayout })

const props = defineProps({
    tags: Object
})

const presetColors = [
    '#64748b', // Slate
    '#ef4444', // Rose/Red
    '#f97316', // Orange
    '#eab308', // Amber
    '#10b981', // Emerald
    '#06b6d4', // Cyan
    '#3b82f6', // Blue
    '#8b5cf6', // Violet
]

const isModalOpen = ref(false)
const editingTag = ref(null)

const form = useForm({
    name: '',
    color_code: '#3b82f6'
})

const openModal = (tag = null) => {
    editingTag.value = tag
    if (tag) {
        form.name = tag.name
        form.color_code = tag.color_code || '#64748b'
    } else {
        form.reset()
        form.color_code = '#3b82f6'
    }
    form.clearErrors()
    isModalOpen.value = true
}

const closeModal = () => {
    isModalOpen.value = false
    editingTag.value = null
    form.reset()
}

const handleSubmit = () => {
    if (editingTag.value) {
        form.put(route('tags.update', editingTag.value.id), {
            onSuccess: () => closeModal()
        })
    } else {
        form.post(route('tags.store'), {
            onSuccess: () => closeModal()
        })
    }
}

const deleteTag = (tag) => {
    if (tag.products_count > 0) {
        alert(`Cannot delete "${tag.name}" because it is assigned to ${tag.products_count} product(s).`)
        return
    }

    if (confirm(`Are you sure you want to delete the tag "${tag.name}"?`)) {
        form.delete(route('tags.destroy', tag.id))
    }
}
</script>

